rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userProfile() {
      return get(/databases/$(database)/documents/attendance_users/$(request.auth.uid)).data;
    }
    function activeUser() {
      return signedIn() && exists(/databases/$(database)/documents/attendance_users/$(request.auth.uid)) && userProfile().active == true;
    }
    function isAdmin() {
      return activeUser() && userProfile().role == 'admin';
    }
    function isManager() {
      return activeUser() && userProfile().role in ['admin', 'manager'];
    }
    match /website_leads/{leadId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'email', 'need', 'consent', 'source', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'need', 'consent', 'source', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^0[0-9]{9,10}$')
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && (request.resource.data.email == '' || request.resource.data.email.matches('^[^ @]+@[^ @]+[.][^ @]+$'))
        && request.resource.data.need in ['GROVA ELEVATOR', 'GROVA ELEVATOR INTERIORS', 'GROVA LAW', 'GROVA EDUCATION', 'Hợp tác khác']
        && request.resource.data.consent == true
        && request.resource.data.source == 'grova-website'
        && request.resource.data.createdAt == request.time;
      allow get, list: if request.auth != null && request.auth.uid == 'oZ3321eD7IOxOqJixysUjgEEvdC3';
      allow update: if request.auth != null
        && request.auth.uid == 'oZ3321eD7IOxOqJixysUjgEEvdC3'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'followUpDate', 'updatedAt'])
        && request.resource.data.status in ['Mới', 'Đã liên hệ', 'Đang tư vấn', 'Đang tư vấn', 'Đã chốt', 'Không tiếp tục']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000
        && request.resource.data.followUpDate is string
        && request.resource.data.followUpDate.matches('^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /attendance_users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }
    match /attendance_sites/{siteId} {
      allow read: if activeUser();
      allow create, update, delete: if isAdmin();
    }
    match /attendance_records/{recordId} {
      allow create: if activeUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.clockInAt == request.time
        && request.resource.data.clockInLocation.latitude is number
        && request.resource.data.clockInLocation.longitude is number
        && request.resource.data.clockInLocation.accuracy is number;
      allow get, list: if activeUser() && (resource.data.uid == request.auth.uid || isManager());
      allow update: if activeUser()
        && resource.data.uid == request.auth.uid
        && resource.data.clockOutAt == null
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.date == resource.data.date
        && request.resource.data.clockInAt == resource.data.clockInAt
        && request.resource.data.clockInLocation == resource.data.clockInLocation
        && request.resource.data.clockOutAt == request.time
        && request.resource.data.clockOutLocation.latitude is number
        && request.resource.data.clockOutLocation.longitude is number
        && request.resource.data.clockOutLocation.accuracy is number;
      allow delete: if isAdmin();
    }
    match /attendance_adjustment_requests/{requestId} {
      allow create: if activeUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 5
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read: if activeUser() && (resource.data.uid == request.auth.uid || isManager());
      allow update: if isManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'reviewNote'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}