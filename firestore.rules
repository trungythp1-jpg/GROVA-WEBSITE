rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userProfile() {
      return get(/databases/$(database)/documents/attendance_users/$(request.auth.uid)).data;
    }
    function activeUser() {
      return signedIn() && exists(/databases/$(database)/documents/attendance_users/$(request.auth.uid)) && userProfile().active == true;
    }
    function isAdmin() {
      return activeUser() && userProfile().role == 'admin';
    }
    function isManager() {
      return activeUser() && userProfile().role in ['admin', 'manager'];
    }
    function roleLevel(role) {
      return role == 'admin' ? 6
        : role == 'executive_director' ? 5
        : role == 'department_head' ? 4
        : role == 'manager' ? 3
        : role == 'team_lead' ? 2
        : role == 'employee' ? 1
        : 0;
    }
    function taskAssigneeLevel(uid) {
      return roleLevel(get(/databases/$(database)/documents/attendance_users/$(uid)).data.role);
    }
    function validDepartment(departmentId) {
      return departmentId in ['marketing', 'sales', 'technical', 'finance_accounting', 'administration_hr', 'legal', 'procurement_supply'];
    }
    function taskAssigneeProfile(uid) {
      return get(/databases/$(database)/documents/attendance_users/$(uid)).data;
    }
    function validTaskDelegation(delegationId, sourceDepartmentId, targetDepartmentId) {
      return delegationId is string
        && exists(/databases/$(database)/documents/attendance_delegations/$(delegationId))
        && get(/databases/$(database)/documents/attendance_delegations/$(delegationId)).data.granteeUid == request.auth.uid
        && get(/databases/$(database)/documents/attendance_delegations/$(delegationId)).data.active == true
        && get(/databases/$(database)/documents/attendance_delegations/$(delegationId)).data.sourceDepartmentIds is list
        && sourceDepartmentId in get(/databases/$(database)/documents/attendance_delegations/$(delegationId)).data.sourceDepartmentIds
        && get(/databases/$(database)/documents/attendance_delegations/$(delegationId)).data.targetDepartmentIds is list
        && targetDepartmentId in get(/databases/$(database)/documents/attendance_delegations/$(delegationId)).data.targetDepartmentIds
        && get(/databases/$(database)/documents/attendance_delegations/$(delegationId)).data.permissions is list
        && 'task_assign' in get(/databases/$(database)/documents/attendance_delegations/$(delegationId)).data.permissions
        && get(/databases/$(database)/documents/attendance_delegations/$(delegationId)).data.validFrom <= request.time
        && (get(/databases/$(database)/documents/attendance_delegations/$(delegationId)).data.validUntil == null || get(/databases/$(database)/documents/attendance_delegations/$(delegationId)).data.validUntil > request.time);
    }
    match /website_leads/{leadId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'email', 'need', 'consent', 'source', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'need', 'consent', 'source', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^0[0-9]{9,10}$')
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && (request.resource.data.email == '' || request.resource.data.email.matches('^[^ @]+@[^ @]+[.][^ @]+$'))
        && request.resource.data.need in ['GROVA ELEVATOR', 'GROVA ELEVATOR INTERIORS', 'GROVA LAW', 'GROVA EDUCATION', 'Hợp tác khác']
        && request.resource.data.consent == true
        && request.resource.data.source == 'grova-website'
        && request.resource.data.createdAt == request.time;
      allow get, list: if request.auth != null && request.auth.uid == 'oZ3321eD7IOxOqJixysUjgEEvdC3';
      allow update: if request.auth != null
        && request.auth.uid == 'oZ3321eD7IOxOqJixysUjgEEvdC3'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'followUpDate', 'updatedAt'])
        && request.resource.data.status in ['Mới', 'Đã liên hệ', 'Đang tư vấn', 'Đã chốt', 'Không tiếp tục']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000
        && request.resource.data.followUpDate is string
        && request.resource.data.followUpDate.matches('^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /attendance_users/{uid} {
      allow get: if activeUser() && (request.auth.uid == uid || roleLevel(userProfile().role) >= 2);
      allow list: if activeUser() && roleLevel(userProfile().role) >= 2;
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['displayName', 'email', 'department', 'departmentId', 'role', 'active'])
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'department', 'departmentId', 'role', 'active'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.department is string
        && request.resource.data.department.size() <= 100
        && validDepartment(request.resource.data.departmentId)
        && request.resource.data.role in ['employee', 'team_lead', 'manager', 'department_head', 'executive_director', 'admin']
        && request.resource.data.active is bool;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'department', 'departmentId', 'role', 'active'])
        && request.resource.data.keys().hasAll(['displayName', 'email', 'department', 'departmentId', 'role', 'active'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.department is string
        && request.resource.data.department.size() <= 100
        && validDepartment(request.resource.data.departmentId)
        && request.resource.data.role in ['employee', 'team_lead', 'manager', 'department_head', 'executive_director', 'admin']
        && request.resource.data.active is bool;
      allow delete: if false;
    }
    match /attendance_sites/{siteId} {
      allow read: if activeUser();
      allow create, update, delete: if isAdmin();
    }
    match /attendance_records/{recordId} {
      allow create: if (activeUser() && request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasAll(['uid', 'date', 'siteId', 'siteName', 'clockInAt', 'clockInLocation', 'clockOutAt', 'clockOutLocation', 'createdAt']) && request.resource.data.keys().hasOnly(['uid', 'date', 'siteId', 'siteName', 'clockInAt', 'clockInLocation', 'clockOutAt', 'clockOutLocation', 'createdAt']) && request.resource.data.date is string && request.resource.data.siteId is string && request.resource.data.siteName is string && request.resource.data.clockOutAt == null && request.resource.data.clockOutLocation == null && request.resource.data.createdAt == request.time && request.resource.data.clockInAt == request.time && request.resource.data.clockInLocation.latitude is number && request.resource.data.clockInLocation.longitude is number && request.resource.data.clockInLocation.accuracy is number) || (isManager() && request.resource.data.adminAdjusted == true && request.resource.data.uid is string && request.resource.data.date is string && request.resource.data.siteId == 'admin-adjustment' && request.resource.data.adjustmentRequestId is string && exists(/databases/$(database)/documents/attendance_adjustment_requests/$(request.resource.data.adjustmentRequestId)) && get(/databases/$(database)/documents/attendance_adjustment_requests/$(request.resource.data.adjustmentRequestId)).data.status == 'approved' && get(/databases/$(database)/documents/attendance_adjustment_requests/$(request.resource.data.adjustmentRequestId)).data.uid == request.resource.data.uid && get(/databases/$(database)/documents/attendance_adjustment_requests/$(request.resource.data.adjustmentRequestId)).data.date == request.resource.data.date);
      allow get, list: if activeUser() && (resource.data.uid == request.auth.uid || isManager());
      allow update: if (activeUser() && resource.data.uid == request.auth.uid && resource.data.clockOutAt == null && request.resource.data.uid == resource.data.uid && request.resource.data.date == resource.data.date && request.resource.data.clockInAt == resource.data.clockInAt && request.resource.data.clockInLocation == resource.data.clockInLocation && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clockOutAt', 'clockOutLocation', 'clockOutSiteId', 'clockOutSiteName']) && request.resource.data.clockOutSiteId is string && request.resource.data.clockOutSiteName is string && request.resource.data.clockOutAt == request.time && request.resource.data.clockOutLocation.latitude is number && request.resource.data.clockOutLocation.longitude is number && request.resource.data.clockOutLocation.accuracy is number) || (isManager() && request.resource.data.uid == resource.data.uid && request.resource.data.date == resource.data.date && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clockInAt', 'clockOutAt', 'adjustmentRequestId', 'adjustmentNote', 'adjustedBy', 'adjustedAt', 'originalClockInAt', 'originalClockOutAt']) && request.resource.data.adjustmentRequestId is string && exists(/databases/$(database)/documents/attendance_adjustment_requests/$(request.resource.data.adjustmentRequestId)) && get(/databases/$(database)/documents/attendance_adjustment_requests/$(request.resource.data.adjustmentRequestId)).data.status == 'approved' && get(/databases/$(database)/documents/attendance_adjustment_requests/$(request.resource.data.adjustmentRequestId)).data.uid == resource.data.uid && get(/databases/$(database)/documents/attendance_adjustment_requests/$(request.resource.data.adjustmentRequestId)).data.date == resource.data.date);
      allow delete: if isAdmin();
    }
    match /attendance_settings/{settingId} {
      allow read: if activeUser();
      allow create, update: if isAdmin()
        && settingId == 'schedule'
        && request.resource.data.keys().hasAll(['startTime', 'endTime', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['startTime', 'endTime', 'updatedAt', 'updatedBy'])
        && request.resource.data.startTime is string
        && request.resource.data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.endTime is string
        && request.resource.data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.endTime > request.resource.data.startTime
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /attendance_delegations/{delegationId} {
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['granteeUid', 'sourceDepartmentIds', 'targetDepartmentIds', 'permissions', 'grantedByUid', 'active', 'validFrom', 'validUntil', 'reason', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['granteeUid', 'sourceDepartmentIds', 'targetDepartmentIds', 'permissions', 'grantedByUid', 'active', 'validFrom', 'validUntil', 'reason', 'createdAt', 'updatedAt'])
        && request.resource.data.granteeUid is string
        && exists(/databases/$(database)/documents/attendance_users/$(request.resource.data.granteeUid))
        && get(/databases/$(database)/documents/attendance_users/$(request.resource.data.granteeUid)).data.active == true
        && get(/databases/$(database)/documents/attendance_users/$(request.resource.data.granteeUid)).data.role in ['team_lead', 'manager', 'department_head', 'executive_director']
        && request.resource.data.sourceDepartmentIds is list
        && request.resource.data.sourceDepartmentIds.size() == 1
        && validDepartment(request.resource.data.sourceDepartmentIds[0])
        && request.resource.data.targetDepartmentIds is list
        && request.resource.data.targetDepartmentIds.size() == 1
        && validDepartment(request.resource.data.targetDepartmentIds[0])
        && request.resource.data.sourceDepartmentIds[0] != request.resource.data.targetDepartmentIds[0]
        && request.resource.data.permissions == ['task_assign']
        && request.resource.data.grantedByUid == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.validFrom == request.time
        && (request.resource.data.validUntil == null || (request.resource.data.validUntil is timestamp && request.resource.data.validUntil > request.time))
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 5
        && request.resource.data.reason.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow get, list: if isAdmin() || (activeUser() && resource.data.granteeUid == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'updatedAt'])
        && request.resource.data.active == false
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /workspace_tasks/{taskId} {
      allow create: if activeUser()
        && request.resource.data.keys().hasAll(['title', 'description', 'assigneeUid', 'assigneeName', 'sourceDepartmentId', 'targetDepartmentId', 'delegationId', 'createdBy', 'createdByName', 'status', 'priority', 'dueDate', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['title', 'description', 'assigneeUid', 'assigneeName', 'sourceDepartmentId', 'targetDepartmentId', 'delegationId', 'createdBy', 'createdByName', 'status', 'priority', 'dueDate', 'createdAt', 'updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 3000
        && request.resource.data.assigneeUid is string
        && request.resource.data.assigneeUid != request.auth.uid
        && request.resource.data.assigneeName is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName is string
        && validDepartment(request.resource.data.sourceDepartmentId)
        && validDepartment(request.resource.data.targetDepartmentId)
        && (isAdmin() || request.resource.data.sourceDepartmentId == userProfile().departmentId)
        && request.resource.data.targetDepartmentId == taskAssigneeProfile(request.resource.data.assigneeUid).departmentId
        && (isAdmin() || (roleLevel(userProfile().role) >= 2 && request.resource.data.sourceDepartmentId == request.resource.data.targetDepartmentId && request.resource.data.delegationId == null) || validTaskDelegation(request.resource.data.delegationId, request.resource.data.sourceDepartmentId, request.resource.data.targetDepartmentId))
        && roleLevel(userProfile().role) > taskAssigneeLevel(request.resource.data.assigneeUid)
        && request.resource.data.status == 'todo'
        && request.resource.data.priority in ['normal', 'high', 'urgent']
        && request.resource.data.dueDate is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/attendance_users/$(request.resource.data.assigneeUid))
        && get(/databases/$(database)/documents/attendance_users/$(request.resource.data.assigneeUid)).data.active == true;
      allow read: if activeUser()
        && (resource.data.assigneeUid == request.auth.uid
          || resource.data.createdBy == request.auth.uid
          || isAdmin()
          || (userProfile().role == 'manager' && resource.data.targetDepartmentId == userProfile().departmentId)
          || (resource.data.delegationId is string && validTaskDelegation(resource.data.delegationId, resource.data.sourceDepartmentId, resource.data.targetDepartmentId)));
      allow update: if activeUser()
        && (resource.data.assigneeUid == request.auth.uid || resource.data.createdBy == request.auth.uid || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['todo', 'in_progress', 'done']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }
    match /attendance_adjustment_requests/{requestId} {
      allow create: if activeUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'date', 'requestedClockIn', 'requestedClockOut', 'reason', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'date', 'requestedClockIn', 'requestedClockOut', 'reason', 'status', 'createdAt'])
        && request.resource.data.date is string
        && request.resource.data.requestedClockIn is string
        && request.resource.data.requestedClockOut is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 5
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read: if activeUser() && (resource.data.uid == request.auth.uid || isManager());
      allow update: if isManager()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'reviewNote', 'appliedRecordId', 'appliedAt'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewNote is string
        && request.resource.data.reviewNote.size() <= 1000;
      allow delete: if isAdmin();
    }

    match /attendance_monthly_confirmations/{confirmationId} {
      allow get: if activeUser() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if activeUser()
        && request.resource.data.keys().hasAll(['uid', 'periodKey', 'periodStart', 'periodEnd', 'totalWorkDays', 'attendanceFingerprint', 'confirmedByUid', 'confirmationType', 'confirmedAt', 'revision', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'periodKey', 'periodStart', 'periodEnd', 'totalWorkDays', 'attendanceFingerprint', 'confirmedByUid', 'confirmationType', 'confirmedAt', 'revision', 'createdAt'])
        && confirmationId == request.resource.data.periodKey + '_' + request.resource.data.uid
        && request.resource.data.uid is string
        && request.resource.data.periodKey is string
        && request.resource.data.periodKey.matches('^[0-9]{4}-[0-9]{2}
      allow create: if activeUser()
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'type', 'date', 'minutes', 'halfDayPeriod', 'reason', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'type', 'date', 'minutes', 'halfDayPeriod', 'reason', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.type in ['early_leave', 'half_day', 'annual_leave']
        && request.resource.data.date is string
        && request.resource.data.minutes is number
        && request.resource.data.halfDayPeriod in ['', 'morning', 'afternoon']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 5
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.type == 'early_leave' && request.resource.data.minutes in [15, 30, 45, 60] && request.resource.data.halfDayPeriod == '')
          || (request.resource.data.type == 'half_day' && request.resource.data.minutes == 0 && request.resource.data.halfDayPeriod in ['morning', 'afternoon'])
          || (request.resource.data.type == 'annual_leave' && request.resource.data.minutes == 0 && request.resource.data.halfDayPeriod == ''));
      allow read: if activeUser() && (resource.data.uid == request.auth.uid || isManager());
      allow update: if isManager()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'reviewNote'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewNote is string
        && request.resource.data.reviewNote.size() <= 1000;
      allow delete: if isAdmin();
    }
  }
