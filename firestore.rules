rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /website_leads/{leadId} {
      allow create: if
        request.resource.data.keys().hasAll([
          'name', 'phone', 'email', 'need', 'consent', 'source', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'name', 'phone', 'email', 'need', 'consent', 'source', 'createdAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.matches('^0[0-9]{9,10}$') &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 254 &&
        (request.resource.data.email == '' ||
          request.resource.data.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')) &&
        request.resource.data.need in [
          'GROVA ELEVATOR',
          'GROVA ELEVATOR INTERIORS',
          'GROVA LAW',
          'GROVA EDUCATION',
          'Hợp tác khác'
        ] &&
        request.resource.data.consent == true &&
        request.resource.data.source == 'grova-website' &&
        request.resource.data.createdAt == request.time;

      allow get, list: if request.auth != null && request.auth.uid == 'ADMIN_UID_TO_CONFIGURE';
      allow update, delete: if false;
    }
  }
}
